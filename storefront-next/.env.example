# Внутренний URL backend для серверных запросов (SSR/ISR/sitemap).
# В Docker это может быть http://backend:8080
INTERNAL_API_URL=http://localhost:8080

# Публичный URL backend для клиентских запросов из браузера.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Канонический URL витрины. Используется для canonical, OG, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000