POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=radio_store

DATABASE_URL=postgres://app:app@localhost:5432/radio_store?sslmode=disable
HTTP_ADDR=:8080

# Для production обязательно задай собственный длинный секрет.
AUTH_JWT_SECRET=akadadioafufnoadnaodaofnaodaodamd
# Каталог для загруженных изображений товаров.
UPLOAD_DIR=./uploads

# --- SMTP для отправки счетов (необязательно для работы создания счёта) ---
# Если SMTP_HOST пустой, кнопка "Отправить счёт" в админке вернёт ошибку,
# а счёт останется в статусе draft.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=billing@radio-store.example
SMTP_FROM_NAME=Radio Store